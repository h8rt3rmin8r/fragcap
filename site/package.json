{
  "name": "fragcap-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prebuild.mjs && next dev",
    "build": "node scripts/prebuild.mjs && next build && node scripts/postbuild.mjs",
    "test:accessibility": "playwright test --config=playwright.config.mjs",
    "test:unit": "node --test tests/changelog-headings.test.mjs",
    "start": "next start",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.14.3",
    "fumadocs-ui": "16.14.3",
    "mermaid": "^11.16.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.4",
    "@types/mdx": "2.0.14",
    "@types/node": "22.18.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "fumadocs-mdx": "15.2.3",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3"
  }
}
