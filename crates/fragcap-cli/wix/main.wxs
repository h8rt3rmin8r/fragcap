<?xml version="1.0" encoding="utf-8"?>
<!--
  fragcap Windows installer (unsigned).

  Built with cargo-wix over WiX v3. cargo-wix links both WixUIExtension (for
  WixUI_InstallDir) and WixUtilExtension (for WixQuietExec, the best-effort
  Defender exclusion, and WixShellExec, the npcap exit-dialog link) by default, so
  the release job passes no extension flags; passing either again makes light fail
  with duplicate-table or duplicate-symbol collisions.

  Payload files (fragcap.exe, catalog.db, LICENSE, NOTICE, fragcap.cdx.json, and THIRD-PARTY-NOTICES.txt) are read from $(var.CargoTargetBinDir): the release job stages them next to the built fragcap.exe before invoking cargo wix.

  UpgradeCode is frozen for the life of the product line; it must never change or
  upgrades will duplicate rather than replace the install.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="*"
           Name="fragcap"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="ShruggieTech"
           UpgradeCode="7F3A2C4E-1D9B-4A6E-9C58-2B0E7D4F6A13">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="fragcap: passive, process-attributed network capture for Windows"
             Manufacturer="ShruggieTech" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of fragcap is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs metadata. WixUI_InstallDir sets ARPNOMODIFY itself. -->
    <Property Id="ARPURLINFOABOUT" Value="https://fragcap.com" />

    <!-- Install layout: ProgramFiles (64-bit) \ fragcap. -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="fragcap">

          <Component Id="Comp_fragcap_exe" Guid="4C1E9A72-6B33-4D8A-BE21-9F5C0A3D7E64">
            <File Id="fragcap_exe"
                  Name="fragcap.exe"
                  Source="$(var.CargoTargetBinDir)\fragcap.exe"
                  KeyPath="yes" />
            <!-- Put fragcap on the system path; effective in newly opened shells. -->
            <Environment Id="PathEntry"
                         Name="PATH"
                         Value="[INSTALLDIR]"
                         Part="last"
                         Action="set"
                         System="yes"
                         Permanent="no" />
          </Component>

          <Component Id="Comp_catalog_db" Guid="A8D4F1C0-2E77-4B95-8A6D-5C3B9E0F1A28">
            <File Id="catalog_db"
                  Name="catalog.db"
                  Source="$(var.CargoTargetBinDir)\catalog.db"
                  ReadOnly="yes"
                  KeyPath="yes" />
          </Component>

          <Component Id="Comp_license" Guid="D2B7E5A1-3C48-4F6B-9D02-7E1A4C8B5F30">
            <File Id="license_txt"
                  Name="LICENSE"
                  Source="$(var.CargoTargetBinDir)\LICENSE"
                  KeyPath="yes" />
          </Component>

          <Component Id="Comp_notice" Guid="F0A3C6E9-7B21-4D4C-9E58-1A2B3C4D5E6F">
            <File Id="notice_txt"
                  Name="NOTICE"
                  Source="$(var.CargoTargetBinDir)\NOTICE"
                  KeyPath="yes" />
          </Component>

          <Component Id="Comp_sbom" Guid="E4C24896-71A8-4BC6-9FC4-3A5F70D2B981">
            <File Id="fragcap_sbom"
                  Name="fragcap.cdx.json"
                  Source="$(var.CargoTargetBinDir)\fragcap.cdx.json"
                  KeyPath="yes" />
          </Component>

          <Component Id="Comp_third_party_notices" Guid="6B9083E1-CF42-4A7D-8596-1EC3F742DA50">
            <File Id="third_party_notices"
                  Name="THIRD-PARTY-NOTICES.txt"
                  Source="$(var.CargoTargetBinDir)\THIRD-PARTY-NOTICES.txt"
                  KeyPath="yes" />
          </Component>

        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="fragcap" Level="1">
      <ComponentRef Id="Comp_fragcap_exe" />
      <ComponentRef Id="Comp_catalog_db" />
      <ComponentRef Id="Comp_license" />
      <ComponentRef Id="Comp_notice" />
      <ComponentRef Id="Comp_sbom" />
      <ComponentRef Id="Comp_third_party_notices" />
    </Feature>

    <!--
      Best-effort Windows Defender exclusion for fragcap's own install directory.
      Deferred, non-impersonated (runs with the installer's elevation), and
      Return="ignore" so a refusal (Tamper Protection, disabled Defender) does not
      fail the install. The command line is set by an immediate action whose
      Property equals the deferred action's Id, which becomes its CustomActionData.

      The install path is passed to PowerShell as a bound parameter of a script
      block (& {param($p) ...} "[INSTALLDIR]."), never interpolated into the
      command text, so a directory name containing a quote or a subexpression is
      treated as data and cannot inject code that would then run elevated. A
      trailing sentinel dot on the argument keeps the path's own trailing
      backslash from escaping the closing quote during argument parsing;
      PowerShell trims the sentinel and the backslash back off. A paired rollback
      action removes the exclusion if a later step fails, so a cancelled install
      leaves no orphaned exclusion.
    -->
    <CustomAction Id="SetDefenderAdd"
                  Property="DefenderAdd"
                  Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;&amp; {param($p) Add-MpPreference -ExclusionPath ($p.TrimEnd([char]46, [char]92))}&quot; &quot;[INSTALLDIR].&quot;"
                  Execute="immediate" />
    <CustomAction Id="DefenderAdd"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="SetDefenderRollback"
                  Property="DefenderRollback"
                  Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;&amp; {param($p) Remove-MpPreference -ExclusionPath ($p.TrimEnd([char]46, [char]92))}&quot; &quot;[INSTALLDIR].&quot;"
                  Execute="immediate" />
    <CustomAction Id="DefenderRollback"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="SetDefenderRemove"
                  Property="DefenderRemove"
                  Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;&amp; {param($p) Remove-MpPreference -ExclusionPath ($p.TrimEnd([char]46, [char]92))}&quot; &quot;[INSTALLDIR].&quot;"
                  Execute="immediate" />
    <CustomAction Id="DefenderRemove"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Optional Wireshark extcap registration (slice 043). Two independent opt-ins,
      both off by default and never forced. They drive the installed binary's own
      `fragcap extcap install`, so no registration logic lives in the installer.

      Per-user runs impersonated so `extcap install` (no directory) resolves the
      installing user's %APPDATA%\Wireshark\extcap rather than SYSTEM's. Machine-wide
      runs non-impersonated (the elevated installer writes under Program Files) into
      the detected Wireshark system extcap directory, and is a clean no-op when
      Wireshark is not installed (WIRESHARK_DIR is empty). Each uses the Defender
      command pattern: an immediate action builds the command line into the deferred
      action's CustomActionData, and the deferred WixQuietExec runs it with
      Return="ignore" so a failure never fails the install. The binary path is passed
      as data, never interpolated into the command text.

      Unlike the Defender exclusion, registration is forward-only: there is no
      rollback and no unregister-on-uninstall. extcap registration is user-managed,
      idempotent state (a user may register or unregister independently with `fragcap
      extcap install` / `uninstall`), so the installer must not delete a registration
      it does not own. Undoing it would clobber an independently managed per-user or
      machine registration on uninstall, on a major upgrade, or on rollback of an
      unrelated failure.
    -->
    <!-- Left unset so the CheckBox controls render unchecked: Windows Installer
         shows a checkbox selected whenever its bound property is non-null, so a
         "0" value would display as checked while the action conditions require
         "1". Unset means unchecked, agreeing with the opt-in conditions. -->
    <Property Id="REGISTEREXTCAP_USER" Secure="yes" />
    <Property Id="REGISTEREXTCAP_MACHINE" Secure="yes" />

    <!-- Wireshark install directory from its registry entry; empty when absent.
         The default value of HKLM\SOFTWARE\Wireshark is the install path. -->
    <Property Id="WIRESHARK_DIR" Secure="yes">
      <RegistrySearch Id="WiresharkInstallDir"
                      Root="HKLM"
                      Key="SOFTWARE\Wireshark"
                      Type="raw"
                      Win64="yes" />
    </Property>

    <!-- Per-user: impersonated, targets the installing user's Wireshark extcap dir. -->
    <CustomAction Id="SetRegisterExtcapUser"
                  Property="RegisterExtcapUser"
                  Value="&quot;[INSTALLDIR]fragcap.exe&quot; extcap install"
                  Execute="immediate" />
    <CustomAction Id="RegisterExtcapUser"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- Machine-wide: non-impersonated, targets Wireshark's system extcap dir. -->
    <CustomAction Id="SetRegisterExtcapMachine"
                  Property="RegisterExtcapMachine"
                  Value="&quot;[INSTALLDIR]fragcap.exe&quot; extcap install --dir &quot;[WIRESHARK_DIR]\extcap&quot;"
                  Execute="immediate" />
    <CustomAction Id="RegisterExtcapMachine"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Install: set the rollback command and queue the rollback immediately
           before the add, so a failure after the add is undone; then add. -->
      <Custom Action="SetDefenderAdd" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="SetDefenderRollback" After="SetDefenderAdd">NOT Installed</Custom>
      <Custom Action="DefenderRollback" After="SetDefenderRollback">NOT Installed</Custom>
      <Custom Action="DefenderAdd" After="DefenderRollback">NOT Installed</Custom>

      <!-- Optional extcap registration, after files exist so fragcap.exe can run.
           Forward-only and best-effort: Return="ignore" keeps a failure non-fatal,
           and the installer does not unregister on uninstall or roll back, because
           extcap registration is user-managed, idempotent state (a user may have
           registered independently with `fragcap extcap install`). Undoing it here
           would delete a registration this install does not own. Users unregister
           with `fragcap extcap uninstall`. Conditioned on the opt-in property (and,
           for machine-wide, on Wireshark being detected). -->
      <Custom Action="SetRegisterExtcapUser" After="DefenderAdd">REGISTEREXTCAP_USER = 1 AND NOT Installed</Custom>
      <Custom Action="RegisterExtcapUser" After="SetRegisterExtcapUser">REGISTEREXTCAP_USER = 1 AND NOT Installed</Custom>
      <Custom Action="SetRegisterExtcapMachine" After="RegisterExtcapUser">REGISTEREXTCAP_MACHINE = 1 AND WIRESHARK_DIR AND NOT Installed</Custom>
      <Custom Action="RegisterExtcapMachine" After="SetRegisterExtcapMachine">REGISTEREXTCAP_MACHINE = 1 AND WIRESHARK_DIR AND NOT Installed</Custom>

      <!-- Uninstall: remove the Defender exclusion before the files are removed.
           extcap registration is intentionally left in place (see above). -->
      <Custom Action="SetDefenderRemove" Before="RemoveFiles">REMOVE="ALL"</Custom>
      <Custom Action="DefenderRemove" After="SetDefenderRemove">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <!--
      Installer UI: license, install directory, and an exit-dialog checkbox that
      opens the npcap download page. npcap is the capture driver fragcap's live
      backend loads; it is never downloaded, bundled, or installed by fragcap, so
      the checkbox only opens the vendor's page, and only when the user leaves it
      checked (slice S060, issue #133).

      The checkbox is pre-checked unless npcap is fully present in the form fragcap
      needs, so a machine that installed npcap as the prerequisite (via Wireshark) is
      not told it still needs it, while a machine without it, or with a driver fragcap
      cannot use, still gets the guidance. "Fully present" mirrors `doctor` exactly
      (PR #160 review, Codex): the npcap check requires npcap's own driver copy
      ([System64Folder]\Npcap\wpcap.dll, NPCAP_INSTALLED), and the winpcap-api check
      requires the WinPcap-API-mode copy the loader resolves by name
      ([System64Folder]\wpcap.dll, NPCAP_WINPCAP_API, spec 20.3). Both are required,
      so npcap installed without WinPcap-API mode, and a legacy WinPcap that dropped
      only the System32 copy, both still pre-check the option, matching what `doctor`
      reports. AppSearch populates each property with its path when the file exists,
      and the SetProperty below leaves WIXUI_EXITDIALOGOPTIONALCHECKBOX pre-checked
      unless both are present. The checkbox text stays non-empty, so the option is
      shown (just unchecked) when the driver is present, and a user who wants it can
      still opt in. [System64Folder] is the native System32 regardless of the MSI's
      bitness, matching the paths `doctor` reads.
    -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <WixVariable Id="WixUILicenseRtf" Value="crates\fragcap-cli\wix\License.rtf" />

    <!-- npcap's own driver copy: present when [System64Folder]\Npcap\wpcap.dll
         exists, matching doctor's npcap_present marker (its npcap check). -->
    <Property Id="NPCAP_INSTALLED" Secure="yes">
      <DirectorySearch Id="System64Dir" Path="[System64Folder]" Depth="0">
        <DirectorySearch Id="NpcapDir" Path="Npcap" Depth="0">
          <FileSearch Id="NpcapWpcapDll" Name="wpcap.dll" />
        </DirectorySearch>
      </DirectorySearch>
    </Property>

    <!-- The WinPcap-API-mode wpcap.dll the loader resolves by name (spec 20.3):
         present when [System64Folder]\wpcap.dll exists, matching doctor's
         system_wpcap marker (its winpcap-api check). -->
    <Property Id="NPCAP_WINPCAP_API" Secure="yes">
      <DirectorySearch Id="System64DirApi" Path="[System64Folder]" Depth="0">
        <FileSearch Id="WpcapDll" Name="wpcap.dll" />
      </DirectorySearch>
    </Property>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Open the npcap download page (fragcap needs the npcap capture driver, if you do not already have it)" />
    <!-- Pre-check the option unless npcap is fully present (both markers). Left unset
         it renders unchecked; SetProperty runs after AppSearch (which populates the
         markers) and before the exit dialog, so the default reflects detection. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Secure="yes" />
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"
                 After="AppSearch" Sequence="ui">NOT (NPCAP_INSTALLED AND NPCAP_WINPCAP_API)</SetProperty>
    <Property Id="WixShellExecTarget" Value="https://npcap.com" />
    <CustomAction Id="LaunchNpcap"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes"
                  Return="ignore" />

    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchNpcap">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>

      <!--
        Optional Wireshark extcap registration dialog, inserted after the
        install-directory dialog. Both checkboxes are off by default (the backing
        properties are unset), so registration is never forced. The properties are
        public, so an administrator can also set them on the command line for a
        silent install (for example REGISTEREXTCAP_MACHINE=1).
      -->
      <Dialog Id="ExtcapDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Wireshark integration (optional)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Register fragcap as a Wireshark extcap capture source." />

        <Control Id="UserCheckBox" Type="CheckBox" X="20" Y="60" Width="330" Height="17" Property="REGISTEREXTCAP_USER" CheckBoxValue="1" Text="Register fragcap for the current user (recommended)" />
        <Control Id="UserNote" Type="Text" X="35" Y="79" Width="320" Height="26" NoPrefix="yes" Text="Registers into your own Wireshark configuration only, for the account running this installer." />

        <Control Id="MachineCheckBox" Type="CheckBox" X="20" Y="114" Width="330" Height="17" Property="REGISTEREXTCAP_MACHINE" CheckBoxValue="1" Text="Register for all users on this machine (administrators)" />
        <Control Id="MachineNote" Type="Text" X="35" Y="133" Width="320" Height="26" NoPrefix="yes" Text="Requires Wireshark to be installed; registers into Wireshark's system extcap directory. Ignored if Wireshark is not found." />

        <Control Id="SkipNote" Type="Text" X="20" Y="175" Width="330" Height="26" NoPrefix="yes" Text="You can leave both unchecked and register later at any time by running: fragcap extcap install" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <!-- Splice ExtcapDlg into the WixUI_InstallDir flow after the install
           directory is chosen. In WiX 3 WixUI_InstallDir the InstallDirDlg Next
           button's terminal NewDialog -> VerifyReadyDlg is at Order 4 (after
           SetTargetPath=1, path validation=2, and the invalid-path SpawnDialog=3),
           so this Order 3 NewDialog fires first and reaches ExtcapDlg; once a
           NewDialog control event fires, Windows Installer stops processing the
           later events, so the stock transition does not also run. Back from the
           confirm dialog uses the stock route to InstallDirDlg (its Back event is
           at Order 1, which an appended event cannot preempt); the checkbox state
           persists in the properties, so clicking Next returns through ExtcapDlg. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ExtcapDlg" Order="3">WIXUI_INSTALLDIR_VALID="1"</Publish>
    </UI>

  </Product>
</Wix>
